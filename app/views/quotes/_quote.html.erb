<div id="<%= dom_id quote %>">
  <div>
    <strong>Source:</strong>
    <%= quote.source_id %>
  </div>

  <div>
    <strong>Body:</strong>
    <%= quote.body %>
  </div>

  <div>
    <strong>Heading path:</strong>
    <%= quote.heading_path %>
  </div>

  <div>
    <strong>Page index:</strong>
    <%= quote.page_index %>
  </div>

  <div>
    <strong>Paragraph index:</strong>
    <%= quote.paragraph_index %>
  </div>

</div>
