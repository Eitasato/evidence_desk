<%= form_with(model: quote) do |form| %>
  <% if quote.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(quote.errors.count, "error") %> prohibited this quote from being saved:</h2>

      <ul>
        <% quote.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :source_id, style: "display: block" %>
    <%= form.collection_select :source_id, Source.all, :id, :title, prompt: "Select a source" %>
  </div>

  <div>
    <%= form.label :body, style: "display: block" %>
    <%= form.textarea :body %>
  </div>

  <div>
    <%= form.label :heading_path, style: "display: block" %>
    <%= form.text_field :heading_path %>
  </div>

  <div>
    <%= form.label :page_index, style: "display: block" %>
    <%= form.number_field :page_index %>
  </div>

  <div>
    <%= form.label :paragraph_index, style: "display: block" %>
    <%= form.number_field :paragraph_index %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
