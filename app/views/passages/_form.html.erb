<%= form_with(model: passage) do |form| %>
  <% if passage.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(passage.errors.count, "error") %> prohibited this passage from being saved:</h2>

      <ul>
        <% passage.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :source_id, style: "display: block" %>
    <%= form.text_field :source_id %>
  </div>

  <div>
    <%= form.label :body, style: "display: block" %>
    <%= form.textarea :body %>
  </div>

  <div>
    <%= form.label :heading_path, style: "display: block" %>
    <%= form.text_field :heading_path %>
  </div>

  <div>
    <%= form.label :page_index, style: "display: block" %>
    <%= form.number_field :page_index %>
  </div>

  <div>
    <%= form.label :paragraph_index, style: "display: block" %>
    <%= form.number_field :paragraph_index %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
