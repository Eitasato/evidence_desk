<div id="<%= dom_id passage %>">
  <div>
    <strong>Source:</strong>
    <%= passage.source_id %>
  </div>

  <div>
    <strong>Body:</strong>
    <%= passage.body %>
  </div>

  <div>
    <strong>Heading path:</strong>
    <%= passage.heading_path %>
  </div>

  <div>
    <strong>Page index:</strong>
    <%= passage.page_index %>
  </div>

  <div>
    <strong>Paragraph index:</strong>
    <%= passage.paragraph_index %>
  </div>

</div>
