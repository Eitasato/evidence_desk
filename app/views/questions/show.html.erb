<p style="color: green"><%= notice %></p>

<%= render @question %>

<div>
  <%= link_to "Edit this question", edit_question_path(@question) %> |
  <%= link_to "Back to questions", questions_path %>

  <%= button_to "Destroy this question", @question, method: :delete %>
</div>

<% EvidenceLink::DECISIONS.each do |decision| %>
  <% links = @links_by_decision.fetch(decision, []) %>
  <section>
    <h2><%= decision %>（<%= links.size %>件）</h2>
    <% links.each do |link| %>
      <% passage = link.passage %>
      <article>
        <p><%= passage.body %></p>
        <p>
          <%= passage.heading_path %>
          ／ <%= passage.page_index %>ページ
          ／ 第<%= passage.paragraph_index %>段落
        </p>
        <p>資料：<%= link_to_if passage.source.url.present?, passage.source.title, passage.source.url, target: "_blank", rel: "noopener" %></p>
        <% if link.note.present? %>
          <p>メモ：<%= link.note %></p>
        <% end %>
      </article>
    <% end %>
  </section>
<% end %>
