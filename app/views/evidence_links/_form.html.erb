<%= form_with(model: evidence_link) do |form| %>
  <% if evidence_link.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(evidence_link.errors.count, "error") %> prohibited this evidence_link from being saved:</h2>

      <ul>
        <% evidence_link.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :question_id, style: "display: block" %>
    <%= form.collection_select :question_id, Question.all, :id, :body, prompt: "Select a question" %>
  </div>

  <div>
    <%= form.label :passage_id, style: "display: block" %>
    <%= form.collection_select :passage_id, Passage.all, :id, :body, prompt: "Select a passage" %>
  </div>

  <div>
    <%= form.label :decision, style: "display: block" %>
    <%= form.select :decision, EvidenceLink::DECISIONS, prompt: "Select a decision" %>
  </div>

  <div>
    <%= form.label :note, style: "display: block" %>
    <%= form.textarea :note %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
